---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Gallery from "../../components/Gallery.astro";
import { STATUS } from "../../lib";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  const at = (n: number) => work[(n + work.length) % work.length];
  return work.map((entry, n) => ({
    params: { slug: entry.id },
    props: { entry, prev: at(n - 1), next: at(n + 1) },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const s = STATUS[d.status];
const { Content } = await render(entry);
const meta = [d.when, d.team, d.course].filter(Boolean);
const [hero, ...more] = d.shots;
---

<Base title={`${d.title}, by Mofftasim Hossain Sayem`} description={d.blurb} quietFooter>
  <article class="band">
    <div class="col page">
      <header class="head" data-reveal="stagger">
        <a class="back" href="/#work"><Icon name="arrow-left" />All work</a>
        <h1>{d.title}</h1>
        <p class="lede">{d.blurb}</p>
        <p class="meta">
          {/* An award says more than the generic status, so it takes the status slot. */}
          <span class="status" data-tone={s.tone}>{d.award ?? s.label}</span>
          {meta.map((m) => <span>{m}</span>)}
        </p>
        {
          d.links.length > 0 && (
            <div class="actions">
              {d.links.map((l, i) => (
                <a class:list={["btn", { solid: i === 0 }]} href={l.href} target="_blank" rel="noopener">
                  {l.label === "GitHub" && <Icon name="github" />}
                  {l.label}
                  <Icon name="arrow-up-right" />
                </a>
              ))}
            </div>
          )
        }
      </header>

      {hero && <Gallery shots={[hero]} layout="hero" transitionName={d.kind === "featured" ? `shot-${entry.id}` : undefined} />}

      {/* Each `##` in the Markdown lands in the label column, and what follows it in the text column. */}
      <div class="write prose" data-reveal>
        <Content />
        {
          d.stack.length > 0 && (
            <>
              <h2>Stack</h2>
              <p class="stack">
                {d.stack.map((t) => <span>{t}</span>)}
              </p>
            </>
          )
        }
      </div>

      {more.length > 0 && <Gallery shots={more} layout="grid" />}

      <nav class="pager" aria-label="More projects">
        <a class="prev" href={`/work/${prev.id}`}>
          <span class="dir"><Icon name="arrow-left" />Previous</span>
          <span class="name">{prev.data.title}</span>
        </a>
        <a class="next" href={`/work/${next.id}`}>
          <span class="dir">Next<Icon name="arrow-right" /></span>
          <span class="name">{next.data.title}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-block: 1.5rem 4rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.85rem;
    color: var(--fg-3);
    transition: color 200ms;
  }

  .back:hover {
    color: var(--fg);
  }

  .back :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 250ms var(--ease-out);
  }

  .back:hover :global(svg) {
    transform: translateX(-3px);
  }

  /* Header: name, what it is in one line, the facts, then the way in. */
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 5vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .lede {
    max-width: 34rem;
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--fg-3);
  }

  .meta > span + span::before {
    content: "·";
    margin-inline: 0.6rem;
    color: var(--line-2);
  }

  .meta .status {
    color: var(--fg-2);
  }

  /* On a phone the status gets its own line, so a wrap never starts with a separator. */
  @media (max-width: 640px) {
    .meta .status {
      flex-basis: 100%;
    }

    .meta .status + span::before {
      content: none;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .actions :global(svg:last-child) {
    width: 0.85rem;
    height: 0.85rem;
    opacity: 0.6;
  }

  /* The write-up: headings in a label column, their text beside them, sections split by hairlines.
     Auto-placement does the pairing: an h2 always starts a new row in column 1, so the block after it
     shares that row and the rest stack below in column 2. */
  .write {
    --gap-s: 1.6rem;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
    color: var(--fg-2);
    line-height: 1.65;
  }

  .write > :global(*) {
    grid-column: 2;
    margin-top: 0.9rem;
    text-wrap: pretty;
  }

  .write > :global(h2) {
    grid-column: 1;
    margin: 0;
    padding: var(--gap-s) 1.5rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.9;
    color: var(--fg-3);
  }

  .write > :global(h2 + *) {
    margin-top: 0;
    padding-top: var(--gap-s);
    border-top: 1px solid var(--line);
  }

  /* Space under the last block of each section, before the next hairline. */
  .write > :global(:has(+ h2)),
  .write > :global(:last-child) {
    padding-bottom: var(--gap-s);
  }

  /* The opening section is the one line a skimmer reads, so it sits brighter. */
  .write > :global(h2:first-child + p) {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--fg);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }

  .stack span + span::before {
    content: "·";
    margin-inline: 0.55rem;
    color: var(--fg-3);
  }

  @media (max-width: 640px) {
    .write {
      --gap-s: 1.35rem;
      grid-template-columns: minmax(0, 1fr);
    }

    .write > :global(*) {
      grid-column: 1;
    }

    .write > :global(h2) {
      padding-right: 0;
    }

    .write > :global(h2 + *) {
      padding-top: 0.35rem;
      border-top: 0;
    }
  }

  .prose :global(ul) {
    display: grid;
    gap: 0.7rem;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 1.1rem;
  }

  .prose :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 99px;
    background: var(--fg-3);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    background: var(--raise);
    font-size: 0.88em;
    color: var(--fg);
  }

  /* Real source, folded away: engineers open it, everyone else reads past. */
  .prose :global(details) {
    margin-top: 1.1rem;
  }

  .prose :global(summary) {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-size: 0.9rem;
    color: var(--fg);
    cursor: url("/cursors/hand.svg") 10 3, pointer;
    list-style: none;
  }

  .prose :global(summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(summary::before) {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 250ms var(--ease-out);
  }

  .prose :global(details[open] summary::before) {
    transform: rotate(45deg);
  }

  .prose :global(summary:hover) {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.25em;
  }

  .prose :global(pre) {
    margin-top: 0.5rem;
    padding: 1rem 1.15rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--raise);
    color: var(--fg);
    font-size: 0.8rem;
    line-height: 1.6;
    tab-size: 2;
    scrollbar-width: thin;
  }

  /* Previous and next, so a reader can walk the whole list without going back. */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .pager a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 0;
  }

  .next {
    text-align: right;
    justify-items: end;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-3);
  }

  .dir :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 250ms var(--ease-out);
  }

  .name {
    font-weight: 600;
    color: var(--fg-2);
    transition: color 200ms;
  }

  .pager a:hover .name {
    color: var(--fg);
  }

  .prev:hover .dir :global(svg) {
    transform: translateX(-3px);
  }

  .next:hover .dir :global(svg) {
    transform: translateX(3px);
  }
</style>
