---
import { FRAME_PHOTOS } from "../lib";
---

<figure class="frame" data-dither>
  <div class="plate">
    <canvas aria-hidden="true"></canvas>
    <div class="ctl">
      <button type="button" data-prev aria-label="Previous photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <span class="mono count" data-count aria-hidden="true">1/{FRAME_PHOTOS.length}</span>
      <button type="button" data-next aria-label="Next photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
  <figcaption class="sr-only" data-caption aria-live="polite">{FRAME_PHOTOS[0].caption}</figcaption>
</figure>

<script>
  import { mountDither } from "../scripts/dither";
  import { FRAME_PHOTOS } from "../lib";
  const el = document.querySelector<HTMLElement>("[data-dither]");
  if (el) mountDither(el, FRAME_PHOTOS);
</script>

<style>
  /* Like anjil.ink: no box at all. The dots sit on the page colour and fade out at the edges,
     so the picture reads as part of the page, set in the same column as the text. */
  .plate {
    position: relative;
    aspect-ratio: 21 / 10;
    background: var(--bg);
  }

  canvas {
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    mask-composite: intersect;
  }

  @media (max-width: 760px) {
    .plate {
      aspect-ratio: 16 / 9;
    }
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    cursor: url("/cursors/cross.svg") 13 13, crosshair;
  }

  .ctl {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.2rem;
    border: 1px solid var(--line-2);
    border-radius: 99px;
    background: rgb(9 9 11 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .plate:hover .ctl,
  .ctl:focus-within {
    opacity: 1;
    transform: none;
  }

  /* On touch there's no hover, so the controls sit under the picture instead of on it. */
  @media (pointer: coarse) {
    .frame {
      margin-bottom: 3rem;
    }

    .ctl {
      top: calc(100% + 0.25rem);
      bottom: auto;
      right: -0.5rem;
      border: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      opacity: 1;
      transform: none;
    }
  }

  .count {
    min-width: 3ch;
    text-align: center;
    font-size: 0.7rem;
    color: var(--fg-3);
  }

  .ctl button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 99px;
    color: var(--fg-2);
    transition:
      background 200ms,
      color 200ms;
  }

  @media (pointer: coarse) {
    .ctl button {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  .ctl button:hover {
    background: var(--raise-2);
    color: var(--fg);
  }

  .ctl svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
